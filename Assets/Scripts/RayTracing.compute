#pragma kernel CSMain

struct RTMaterial
{
    float4 color;
    float4 emission;
    float roughness;
};

struct SphereData
{
    float3 center;
    float radius;
};

struct GPUMesh
{
    int root;
};

struct BVHNode
{
    float3 boxMin, boxMax;
    int left;
    int triCount;
};

struct GPUObject 
{
    RTMaterial material;
    GPUMesh mesh;
};

struct HitInfo
{
    float distance;
    float3 hitPoint;
    float3 hitDir;
    float3 normal;
    int objIndex;
};

struct Ray
{
    float3 origin;
    float3 direction;
};

static const float INF = 1e30;

RWTexture2D<float4> result, sum;

StructuredBuffer<GPUObject> objects;
uint objectCount;

StructuredBuffer<int> triangles;
uint triangleCount;

StructuredBuffer<float3> vertices;
uint vertexCount;

StructuredBuffer<BVHNode> nodes;

static const float4 white = {1, 1, 1, 1}, black = {0, 0, 0, 1};
float4 skyColor;

static uint state; 

float3 camPos, camForward, camRight, camUp;
uint width, height;
float fov;
uint frame;
uint maxBounce;

uint PCGHash(inout uint state)
{
    state = state * 747796405u + 2891336453u;
    uint word = ((state >> ((state >> 28u) + 4u)) ^ state) * 277803737u;
    return (word >> 22u) ^ word;
}

float RandomFloat(inout uint state)  // 0..1
{
    return PCGHash(state) / 4294967295.0;
}

float3 RandomVecInCube(inout uint state) // x/y/z: -1..1
{
    return float3(RandomFloat(state)*2-1, RandomFloat(state)*2-1, RandomFloat(state)*2-1);
}

float3 RandomVecInSphere(inout uint state) 
{
    float3 res = RandomVecInCube(state);
    while (length(res) > 1) {
        res = RandomVecInCube(state);
    }
    
    return res;
}

void Swap(inout int a, inout int b) 
{
    int temp;
    temp = b;
    b = a; a = temp;
}

void Swap(inout float a, inout float b) 
{
    float temp;
    temp = b;
    b = a; a = temp;    
}

float IntersectSphere(Ray ray, SphereData sphere)
{
    float3 oc = ray.origin - sphere.center;
    float b = dot(oc, ray.direction);
    float c = dot(oc, oc) - sphere.radius * sphere.radius;
    float disc = b * b - c;

    if (disc < 0) return INF;

    float s = sqrt(disc);

    float t = -b - s;
    if (t > 0.001f) return t;

    t = -b + s;
    if (t > 0.001f) return t;

    return INF;
}

static const float EDGE_EPS = 1e-5;
// Möller–Trumbore ray-triangle intersection.
// t = distance along ray, u/v = barycentric coords.
float IntersectTriangle(Ray ray, float3 v0, float3 v1, float3 v2)
{
    float t = 0, u = 0, v = 0;

    float3 e1 = v1 - v0;
    float3 e2 = v2 - v0;
    float3 p = cross(ray.direction, e2);
    float det = dot(e1, p);
    if (det < 1e-8) return INF;   // back face, or ray parallel to triangle

    float invDet = 1.0 / det;

    float3 s = ray.origin - v0;
    u = dot(s, p) * invDet;
    if (u < -EDGE_EPS || u > 1 + EDGE_EPS) return INF;

    float3 q = cross(s, e1);
    v = dot(ray.direction, q) * invDet;
    if (v < -EDGE_EPS || u + v > 1 + EDGE_EPS) return INF;

    t = dot(e2, q) * invDet;
    return t > 1e-6 ? t : INF;   // small offset avoids hitting the surface you just bounced off
}

float IntersectBox(Ray ray, float3 boxMin, float3 boxMax)
{
    float3 invDir = 1.0 / ray.direction;
    float3 t0 = (boxMin - ray.origin) * invDir;
    float3 t1 = (boxMax - ray.origin) * invDir;

    float3 tNear = min(t0, t1);   // entry distance per axis
    float3 tFar  = max(t0, t1);   // exit distance per axis

    float enter = max(max(tNear.x, tNear.y), tNear.z);
    float exit  = min(min(tFar.x, tFar.y), tFar.z);

    return enter <= exit && exit > 0 ? enter : INF;
}

HitInfo IntersectMesh(Ray ray, int objIndex, float maxDist) {
    GPUMesh mesh = objects[objIndex].mesh;
    HitInfo closestHit = (HitInfo)0;    
    closestHit.distance = INF;

    int dfsNodes[32];
    int size = 1;
    dfsNodes[0] = mesh.root;

    while (size) {
        int v = dfsNodes[size - 1];
        size--;
        if (IntersectBox(ray, nodes[v].boxMin, nodes[v].boxMax) >= maxDist) continue;

        if (nodes[v].triCount == 0) {
            int x = nodes[v].left, y = x + 1;
            float distX = IntersectBox(ray, nodes[x].boxMin, nodes[x].boxMax);
            float distY = IntersectBox(ray, nodes[y].boxMin, nodes[y].boxMax);
            if (distX > distY) {
                Swap(x, y);
                Swap(distX, distY);
            }
            
            if (distY < maxDist) {
                size++;
                dfsNodes[size - 1] = y;
            }
            if (distX < maxDist) {
                size++;
                dfsNodes[size - 1] = x;
            }
            continue;
        }

        for (int i = nodes[v].left * 3; i < (nodes[v].left + nodes[v].triCount) * 3; i += 3) {
            float3 v0 = vertices[triangles[i]];
            float3 v1 = vertices[triangles[i + 1]];
            float3 v2 = vertices[triangles[i + 2]];
            float dist = IntersectTriangle(ray, v0, v1, v2);

            if (dist < closestHit.distance) {
                float3 n = normalize(cross(v1 - v0, v2 - v0));
                if (dot(n, ray.direction) > 0) {
                    n = -n;
                }

                HitInfo hitInfo = {
                    dist,
                    ray.origin + ray.direction * dist, 
                    ray.direction, 
                    n, 
                    objIndex
                };
                closestHit = hitInfo;

                maxDist = min(maxDist, closestHit.distance);
            }
        }
    }

    return closestHit;
}

Ray RandomRay(HitInfo hit, float3 normal)
{
    float3 diffuseDir = normalize(normal + normalize(RandomVecInSphere(state)));
    float3 mirrorDir = reflect(hit.hitDir, normal);
    float3 dir = normalize(lerp(mirrorDir, diffuseDir, objects[hit.objIndex].material.roughness));

    Ray res = {hit.hitPoint, dir};
    return res;   
}

bool IsSame(float4 a, float4 b) {
    return all(abs(a - b).rgb < 0.001);
}

float4 TraceRay(Ray ray, float4 rayColor)
{
    float4 res = {0, 0, 0, 1};
    for (uint depth = 0; depth < maxBounce && !IsSame(rayColor, black); depth++) {
        HitInfo closestHit = (HitInfo)0;
        closestHit.distance = INF;

        for (uint i = 0; i < objectCount; i++) {
            HitInfo hitInfo = IntersectMesh(ray, i, closestHit.distance);
            if (hitInfo.distance < closestHit.distance)
            {
                closestHit = hitInfo;
            }
        }

        if (closestHit.distance == INF) {
            res += skyColor * rayColor;
            break;
        }

        res += objects[closestHit.objIndex].material.emission * rayColor;

        ray = RandomRay(closestHit, closestHit.normal);
        rayColor *= objects[closestHit.objIndex].material.color;
    }

    res.a = 1;
    return res;
}

Ray GetCameraRay(int x, int y)
{
    float3 origin = camPos;
    float ratio = (float)width / height;

    float u = (x + RandomFloat(state)) / width * 2 - 1;
    float v = (y + RandomFloat(state)) / height * 2 - 1;
    float halfHeight = tan(fov / 2), halfWidth = halfHeight * ratio;

    float3 direction = normalize(camForward + camRight * u * halfWidth + camUp * v * halfHeight);

    Ray res = {origin, direction};
    return res;
}

[numthreads(8,8,1)]
void CSMain(uint3 id : SV_DispatchThreadID)
{
    if (id.x >= width || id.y >= height) return;    

    state = id.x + id.y * width + frame * width * height;

    int cnt = 1;
    sum[id.xy] = 0;
    for (int i = 1; i <= cnt; i++) {
        sum[id.xy] += TraceRay(GetCameraRay(id.x, id.y), white);
    }
    result[id.xy] = lerp(result[id.xy], sum[id.xy] / cnt, 1.0 / frame);

    // result[id.xy] = float4(id.x & id.y, (id.x & 15)/15.0, (id.y & 15)/15.0, 1.0);
}
